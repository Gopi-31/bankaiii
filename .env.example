# ANiii STORE - Environment Configuration Template
# Copy this file to .env for local development or custom deployment setups.
# NEVER commit actual production secrets or credentials to source control.

# Local Static Web Server Port
PORT=3000

# Environment Mode: 'development' | 'production' | 'test'
NODE_ENV=development

# Application Base URL
APP_URL=http://localhost:3000

# Client Storage Prefix (namespaces localStorage items to avoid collision)
STORAGE_KEY_PREFIX=aniii_

# Feature Flags
ENABLE_ANALYTICS=false
ENABLE_DEBUG_LOGGING=true
ENABLE_OFFLINE_STORAGE=true

# External Asset Fallback CDN
IMAGE_FALLBACK_URL=https://images.unsplash.com/photo-1578632767115-351597cf2477

# Future API Backend Configuration (Reserved for v2.0 REST Backend)
# API_BASE_URL=https://api.aniii-store.local/v1
# API_TIMEOUT_MS=5000
